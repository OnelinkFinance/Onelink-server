// =====================================================================================================
// wf_cfi_from_cfda — a client's CFDA balance changed (money received or paid out)
// Zoho Books > Settings > Automation > Custom Functions > New > Module: Client CFDA Balance
// Keep the header Zoho generates (record arrives as `cm_client_cfda_balance`); paste this as the body.
// Workflow rule: see README ("Client CFDA Balance — fund check").
// This is also what keeps open payment requests current when the balance moves after they were checked.
// =====================================================================================================
orgId = "898300452";
base = "https://www.zohoapis.com/books/v3/";
conn = "cfibooks";

b = cm_client_cfda_balance;
clientId = ifnull(b.get("cf_client"), "").toString();
if(clientId == "")
{
	return;
}
bid = ifnull(b.get("module_record_id"), ifnull(b.get("record_id"), b.get("id"))).toString();
clientName = ifnull(b.get("record_name"), "").toString().trim();
reason = zoho.currenttime.toString("yyyy-MM-dd HH:mm:ss") + "|cfda|" + bid + "|" + zoho.loginuser;

found = "";
search = invokeurl
[
	url :base + "cm_client_fund_intelligence"
	type :GET
	parameters:{"organization_id":orgId,"search_text":clientName,"per_page":50}
	connection:conn
];
for each x in ifnull(search.get("module_records"), List())
{
	if(ifnull(x.get("cf_client"), "").toString() == clientId)
	{
		found = x.get("module_record_id").toString();
	}
}
if(found != "")
{
	resp = invokeurl
	[
		url :base + "cm_client_fund_intelligence/" + found + "?organization_id=" + orgId
		type :PUT
		parameters:{"cf_recalc_requested":reason}.toString()
		headers:{"Content-Type":"application/json"}
		connection:conn
	];
}
else
{
	resp = invokeurl
	[
		url :base + "cm_client_fund_intelligence?organization_id=" + orgId
		type :POST
		parameters:{"record_name":clientName,"cf_client":clientId,"cf_client_id":clientId,"cf_recalc_requested":reason}.toString()
		headers:{"Content-Type":"application/json"}
		connection:conn
	];
}
info resp;
